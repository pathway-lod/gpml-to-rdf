// PlantMetWiki data transformation pipeline
digraph PlantMetWiki_pipeline {
	bgcolor=white fontname=Arial fontsize=11 nodesep=0.5 rankdir=TB ranksep=0.7
	node [fontname=Arial fontsize=10 margin="0.15,0.10"]
	edge [color="#555555" fontname=Arial fontsize=9]
	subgraph cluster_source {
		color="#2980b9" fillcolor="#dbe9f4" fontcolor="#2980b9" fontname=Arial fontsize=11 label="Source data" penwidth=1.5 style="filled,rounded"
		plantcyc [label="PlantCyc 17.0
1,162 pathways - 1,316 reactions
455 ORG-IDs -> 439 NCBI taxa" fillcolor=white shape=cylinder style=filled]
		mibig [label="MIBiG 4.0
43 BGCs (9 A. thaliana, 34 untyped)" fillcolor=white shape=cylinder style=filled]
		plantismash [label="plantiSMASH v2
65 predicted BGCs
Arabidopsis thaliana only" fillcolor=white shape=cylinder style=filled]
		ncbitaxon_src [label="NCBITaxon (OBO Foundry)
CC0 licence" fillcolor=white shape=cylinder style=filled]
		wikidata_src [label="Wikidata
(federated via InChIKey)" fillcolor=white shape=cylinder style=filled]
	}
	subgraph cluster_tools {
		color="#e67e22" fillcolor="#fef3cd" fontcolor="#e67e22" fontname=Arial fontsize=11 label="Pipeline tools" penwidth=1.5 style="filled,rounded"
		validate [label="validate_plantcyc_input.py
5 ERRORs (skipped) - 2 WARNINGs" fillcolor=white shape=diamond style=filled]
		cyc2wiki [label="Cyc_to_wiki + build_pathways.py
2,478 GPML2021 files
8,259 GeneProduct - 10,715 Protein
23,449 Metabolite - 34,273 interactions" fillcolor=white shape=box style="filled,rounded"]
		xsd_val [label="test_gpml_files.py
GPML2021 XSD validation
0 errors" fillcolor=white shape=box style="filled,rounded"]
		gpml2rdf [label="gpml-to-rdf  (Java + Python scripts)
gpml2rdf-4.0.4.jar - taxonomy extra - properties extra
Core 3,826,567 + Tax 30,178 + Prop 2,617,839 triples" fillcolor=white shape=box style="filled,rounded"]
		rdf_validate [label="validate_rdf.py
0 errors - 6,474,584 triples verified" fillcolor=white ordering=out shape=diamond style=filled]
		load_ncbi [label="load-ncbitaxon.sh --subset plantmetwiki
ROBOT v1.9.6  extract --method MIREOT
424 seed taxa + ancestors  ->  17,707 triples
1.4 MB  (full release: 1,800 MB)" fillcolor=white ordering=out shape=box style="filled,rounded"]
		map2rdf [label="map-to-rdf  (convert_bgc_to_rdf.py)
Scope: Arabidopsis thaliana only
199 BGC-pathway crosslinks (SPARQL join) - 7,843 triples" fillcolor=white ordering=out shape=box style="filled,rounded"]
		void_create [label="create_void_from_metadata.py (core)
create_void_bgc.py (BGC)
5 void:Dataset + 1 void:Linkset  ->  151 triples" fillcolor=white ordering=out shape=box style="filled,rounded"]
	}
	subgraph cluster_virtuoso {
		color="#27ae60" fillcolor="#d5f5e3" fontcolor="#27ae60" fontname=Arial fontsize=11 label="Virtuoso 7.2  --  6,500,285 total triples  (7 named graphs)" penwidth=1.5 style="filled,rounded"
		subgraph cluster_core_graphs {
			color="#27ae60" fontcolor="#27ae60" fontname=Arial fontsize=9 label="core RDF (gpml-to-rdf)" style=dashed
			g_pathways [label="graph/pathways
3,826,567 triples" fillcolor=white shape=tab style=filled]
			g_taxextra [label="graph/gpml-taxonomy-extra
30,178 triples
425/439 taxa - 6 absent from OBO Foundry" fillcolor=white shape=tab style=filled]
			g_propextra [label="graph/gpml-properties-extra
2,617,839 triples" fillcolor=white shape=tab style=filled]
		}
		g_bgc_plantismash [label="graph/bgc-plantismash
6,030 triples" fillcolor=white shape=tab style=filled]
		g_bgc_mibig [label="graph/bgc-mibig
1,813 triples" fillcolor=white shape=tab style=filled]
		g_ncbi [label="graph/ncbitaxon
17,707 triples
MIREOT subset  v2026-05-13" fillcolor=white shape=tab style=filled]
		g_void [label="graph/void
151 triples
5 void:Dataset descriptions + 1 void:Linkset" fillcolor=white shape=tab style=filled]
	}
	subgraph cluster_access {
		color="#8e44ad" fillcolor="#e8daef" fontcolor="#8e44ad" fontname=Arial fontsize=11 label="Access & results" penwidth=1.5 style="filled,rounded"
		sparql [label="SPARQL endpoint
https://sparql-plantmetwiki.bioinformatics.nl" fillcolor=white shape=component style=filled]
		snorql [label="Snorql-UI
https://plantmetwiki.bioinformatics.nl" fillcolor=white shape=box style="filled,rounded"]
		notebooks [label="Jupyter notebooks
4,577 metabolites (4,111 with InChIKey)
Figures - Cross-species inference - Federated queries" fillcolor=white shape=note style=filled]
		sparql_examples [label="SPARQL query examples
github.com/pathway-lod/SPARQLQueries
customizable via Snorql-UI settings" fillcolor=white shape=note style=filled]
		tutorials [label="Tutorial pages
Step-by-step SPARQL - federated queries" fillcolor=white shape=note style=filled]
		sparql -> snorql [style=invis]
		sparql -> notebooks [style=invis]
	}
	plantcyc -> validate
	validate -> cyc2wiki [label="5 ERRORs skipped"]
	cyc2wiki -> xsd_val [label="2,478 GPML files"]
	xsd_val -> gpml2rdf [label="XSD pass"]
	gpml2rdf -> rdf_validate [label="TTL output"]
	rdf_validate -> g_pathways [label="0 errors"]
	rdf_validate -> g_taxextra
	rdf_validate -> g_propextra
	mibig -> map2rdf
	plantismash -> map2rdf
	map2rdf -> g_bgc_plantismash
	map2rdf -> g_bgc_mibig
	ncbitaxon_src -> load_ncbi
	load_ncbi -> g_ncbi
	rdf_validate -> void_create [style=dashed]
	map2rdf -> void_create [style=dashed]
	void_create -> g_void
	g_pathways -> sparql
	g_taxextra -> sparql
	g_propextra -> sparql
	g_bgc_plantismash -> sparql
	g_bgc_mibig -> sparql
	g_ncbi -> sparql
	g_void -> sparql
	sparql -> snorql
	sparql -> notebooks
	snorql -> sparql_examples [label="loads from GitHub" style=dashed]
	snorql -> tutorials [style=dashed]
	wikidata_src -> notebooks [label="federated SPARQL" style=dashed]
	wikidata_src -> sparql_examples [label="federated SPARQL" style=dashed]
}
