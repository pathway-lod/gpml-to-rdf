// PlantMetWiki pipeline -- horizontal layout for slides
digraph PlantMetWiki_pipeline_horizontal {
	bgcolor=white fontname=Arial fontsize=11 nodesep=0.35 rankdir=LR ranksep=0.6
	node [fontname=Arial fontsize=9 margin="0.12,0.08"]
	edge [color="#555555" fontname=Arial fontsize=8]
	subgraph cluster_source {
		color="#2980b9" fillcolor="#dbe9f4" fontcolor="#2980b9" fontname=Arial fontsize=10 label="Source data" penwidth=1.5 style="filled,rounded"
		plantcyc [label="PlantCyc 17.0
1,162 pathways
1,316 reactions
439 NCBI taxa" fillcolor=white shape=cylinder style=filled]
		ncbitaxon_src [label="NCBITaxon
(OBO Foundry, CC0)" fillcolor=white shape=cylinder style=filled]
		mibig [label="MIBiG 4.0
43 BGCs (9 A. thaliana)" fillcolor=white shape=cylinder style=filled]
		plantismash [label="plantiSMASH v2
65 BGCs (Arabidopsis thaliana)" fillcolor=white shape=cylinder style=filled]
		wikidata_src [label="Wikidata
(federated)" fillcolor=white shape=cylinder style=filled]
	}
	subgraph cluster_tools {
		color="#e67e22" fillcolor="#fef3cd" fontcolor="#e67e22" fontname=Arial fontsize=10 label="Pipeline tools" penwidth=1.5 style="filled,rounded"
		validate [label="validate_plantcyc_input.py
5 ERRORs - 2 WARNINGs" fillcolor=white shape=diamond style=filled]
		cyc2wiki [label="Cyc_to_wiki + build_pathways.py
2,478 GPML2021 files
8,259 GP - 10,715 Prot - 23,449 Met" fillcolor=white shape=box style="filled,rounded"]
		xsd_val [label="XSD validation
0 errors" fillcolor=white shape=box style="filled,rounded"]
		gpml2rdf [label="gpml-to-rdf
Core 3,826,567 triples
+ Tax 30,178 - Prop 2,617,839" fillcolor=white shape=box style="filled,rounded"]
		rdf_validate [label="validate_rdf.py
0 errors - 6,474,584 triples" fillcolor=white ordering=out shape=diamond style=filled]
		load_ncbi [label="ROBOT MIREOT
424 taxa -> 17,707 triples
1.4 MB (from 1,800 MB)" fillcolor=white ordering=out shape=box style="filled,rounded"]
		map2rdf [label="map-to-rdf  (Arabidopsis thaliana)
199 BGC crosslinks" fillcolor=white ordering=out shape=box style="filled,rounded"]
		void_create [label="create_void_*.py
151 triples" fillcolor=white ordering=out shape=box style="filled,rounded"]
	}
	subgraph cluster_virtuoso {
		color="#27ae60" fillcolor="#d5f5e3" fontcolor="#27ae60" fontname=Arial fontsize=10 label="Virtuoso 7.2
6,500,285 triples (7 graphs)" penwidth=1.5 style="filled,rounded"
		subgraph cluster_core_graphs {
			color="#27ae60" fontcolor="#27ae60" fontname=Arial fontsize=8 label="core RDF" style=dashed
			g_pathways [label="graph/pathways
3,826,567" fillcolor=white shape=tab style=filled]
			g_taxextra [label="graph/taxonomy-extra
30,178 - 6 absent" fillcolor=white shape=tab style=filled]
			g_propextra [label="graph/properties-extra
2,617,839" fillcolor=white shape=tab style=filled]
		}
		g_bgc_plantismash [label="graph/bgc-plantismash
6,030" fillcolor=white shape=tab style=filled]
		g_bgc_mibig [label="graph/bgc-mibig
1,813" fillcolor=white shape=tab style=filled]
		g_ncbi [label="graph/ncbitaxon
17,707
MIREOT v2026-05-13" fillcolor=white shape=tab style=filled]
		g_void [label="graph/void
151" fillcolor=white shape=tab style=filled]
	}
	subgraph cluster_access {
		color="#8e44ad" fillcolor="#e8daef" fontcolor="#8e44ad" fontname=Arial fontsize=10 label="Access & results" penwidth=1.5 style="filled,rounded"
		sparql [label="SPARQL endpoint" fillcolor=white shape=component style=filled]
		snorql [label="Snorql-UI
browser interface" fillcolor=white shape=box style="filled,rounded"]
		sparql -> snorql [style=invis]
		sparql_examples [label="SPARQL examples
(GitHub, customizable)" fillcolor=white shape=note style=filled]
		tutorials [label="Tutorial pages
federated queries" fillcolor=white shape=note style=filled]
		notebooks [label="Jupyter notebooks
4,577 metabolites
figures - inference" fillcolor=white shape=note style=filled]
	}
	plantcyc -> validate
	validate -> cyc2wiki [label="5 skipped"]
	cyc2wiki -> xsd_val
	xsd_val -> gpml2rdf [label="XSD pass"]
	gpml2rdf -> rdf_validate
	rdf_validate -> g_pathways [label="0 errors"]
	rdf_validate -> g_taxextra
	rdf_validate -> g_propextra
	mibig -> map2rdf
	plantismash -> map2rdf
	map2rdf -> g_bgc_plantismash
	map2rdf -> g_bgc_mibig
	ncbitaxon_src -> load_ncbi
	load_ncbi -> g_ncbi
	rdf_validate -> void_create [style=dashed]
	map2rdf -> void_create [style=dashed]
	void_create -> g_void
	g_pathways -> sparql
	g_taxextra -> sparql
	g_propextra -> sparql
	g_bgc_plantismash -> sparql
	g_bgc_mibig -> sparql
	g_ncbi -> sparql
	g_void -> sparql
	sparql -> snorql
	sparql -> notebooks
	snorql -> sparql_examples [label=GitHub style=dashed]
	snorql -> tutorials [style=dashed]
	wikidata_src -> notebooks [label=federated style=dashed]
	wikidata_src -> sparql_examples [label=federated style=dashed]
}
